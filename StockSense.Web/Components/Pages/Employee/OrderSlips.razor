    private async Task SendEmailAndSave(OrderSlipDto slip)
    {
        processingSlips.Add(slip.SlipNumber);
    
        try
        {
            var bytes = await OrderService.GeneratePdfBytesAsync(slip);
        
            // 🚨 OVERRIDE HERE FOR DEBUGGING 🚨
            // Ignore the supplier's email and force it to your own
            string targetEmail = "37craven@gmail.com"; 
        
            await OrderService.SendEmailAsync(targetEmail, bytes, slip.SlipNumber);
            await OrderService.SaveOrderSlipToDbAsync(slip);
            slips.Remove(slip);
        }
        finally
        {
            processingSlips.Remove(slip.SlipNumber);
        }
    }
}